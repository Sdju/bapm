{
  "name": "@bapm/root",
  "version": "0.0.0",
  "private": true,
  "description": "Better Agent Package Manager — TypeScript APM with a clean architecture",
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run --filter @bapm/docs dev",
    "docs": "vp run --filter @bapm/docs dev",
    "build": "vp run -r build",
    "check": "vp check",
    "test": "vp run -r test",
    "conformance:gen": "node scripts/gen-conformance-statement.mjs",
    "conformance:check": "node scripts/check-conformance-drift.mjs",
    "agent-plugins:gen": "node scripts/gen-agent-plugins-compatibility.mjs",
    "agent-plugins:check": "node scripts/gen-agent-plugins-compatibility.mjs --check",
    "version:bump": "bumpp packages/*/package.json"
  },
  "devDependencies": {
    "bumpp": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}
