{
  "name": "@b-apm/cli",
  "version": "0.1.0",
  "description": "bapm CLI — Better Agent Package Manager",
  "keywords": [
    "b-apm",
    "bapm",
    "unstable"
  ],
  "homepage": "https://github.com/Sdju/bapm#readme",
  "bugs": {
    "url": "https://github.com/Sdju/bapm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sdju/bapm.git",
    "directory": "packages/cli"
  },
  "bin": {
    "bapm": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@b-apm/core": "workspace:*",
    "@b-apm/integration-api": "workspace:*"
  },
  "devDependencies": {
    "@b-apm/integration-cursor": "workspace:*",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "feod": {
    "srcRoot": "src",
    "aliasPrefix": "@",
    "layerDirs": {
      "app": "app",
      "pages": "commands",
      "modules": "modules",
      "common": "common",
      "global": "globals"
    },
    "common": {
      "allowIndex": false
    },
    "modules": {
      "publicEntry": "index.ts",
      "allowDeepImports": false,
      "singleFileModules": false
    },
    "pages": {
      "useFileBasedRouting": false,
      "modulePages": false,
      "privateModulesPrefix": null
    }
  }
}
