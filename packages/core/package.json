{
  "name": "@b-apm/core",
  "version": "0.1.0",
  "description": "Core library for bapm: manifest, lockfile, resolver, install, adapters",
  "keywords": [
    "b-apm",
    "bapm",
    "unstable"
  ],
  "homepage": "https://github.com/Sdju/bapm#readme",
  "bugs": {
    "url": "https://github.com/Sdju/bapm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sdju/bapm.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@b-apm/integration-api": "workspace:*",
    "fflate": "catalog:",
    "semver": "catalog:",
    "tldts": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@b-apm/integration-claude": "workspace:*",
    "@b-apm/integration-codex": "workspace:*",
    "@b-apm/integration-cursor": "workspace:*",
    "@b-apm/integration-opencode": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "feod": {
    "srcRoot": "src",
    "aliasPrefix": "@",
    "layerDirs": {
      "app": "app",
      "pages": "pages",
      "modules": "modules",
      "common": "common",
      "global": "globals"
    },
    "common": {
      "allowIndex": false
    },
    "modules": {
      "publicEntry": "index.ts",
      "allowDeepImports": false,
      "singleFileModules": false
    },
    "pages": {
      "useFileBasedRouting": false,
      "modulePages": false,
      "privateModulesPrefix": null
    }
  }
}
